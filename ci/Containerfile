# Minimal transport image for the Fedora-built swaylock-plugin and
# swaylock-sleep-watcher binaries.
#
# The binaries are dynamically linked against the host's Fedora system libraries
# (libc, libcairo, libpam, libwayland, ...) and are not meant to run inside this
# image. The image exists so the exact binaries and their provenance can be
# pulled and extracted with `podman cp`; consumers install them on a matching
# Fedora 45 host.
FROM scratch

ARG SOURCE=https://github.com/herb/swaylock-plugin
ARG REVISION=unknown
ARG VERSION=unknown
ARG LICENSES=MIT
ARG FEDORA_VERSION=45

LABEL org.opencontainers.image.title="swaylock-plugin" \
	org.opencontainers.image.description="Fedora 45 build of the swaylock-plugin screen locker" \
	org.opencontainers.image.source="${SOURCE}" \
	org.opencontainers.image.revision="${REVISION}" \
	org.opencontainers.image.version="${VERSION}" \
	org.opencontainers.image.licenses="${LICENSES}" \
	io.github.herb.fedora-version="${FEDORA_VERSION}"

# actions/upload-artifact drops file modes, so set them explicitly.
COPY --chmod=0755 swaylock-plugin /usr/bin/swaylock-plugin
COPY --chmod=0755 swaylock-sleep-watcher /usr/bin/swaylock-sleep-watcher
COPY --chmod=0644 LICENSE /LICENSE
